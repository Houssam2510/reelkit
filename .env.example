# ---------------------------------------------------------------------------
# Reelkit — environment
# Copy to `.env`. Nothing here is read by the renderer; these keys are only
# used by the tools in `tools/`, which run on your machine before a render.
# ---------------------------------------------------------------------------

# --- ElevenLabs (tools/vo.mjs, tools/voices.mjs) ---------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Default voice for `npm run vo`. Accepts a voice id, or a name that
# `tools/voices.mjs` can resolve ("Brian", "Sarah", …). Per-film overrides go
# in the film's script.json, which always wins over this.
ELEVENLABS_VOICE_ID=

# Model. `eleven_multilingual_v2` is the reliable default and is the only tier
# guaranteed to return character timestamps (which the burned-in captions and
# the auto-timed edit both depend on). `eleven_turbo_v2_5` is cheaper/faster.
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Rendering -------------------------------------------------------------
# Optional. Point at an existing Chrome/Chromium so Remotion does not download
# its own headless shell. Find one with: npx @puppeteer/browsers list
REMOTION_BROWSER_EXECUTABLE=
